# Copy to `.env` and fill in. Expo only exposes EXPO_PUBLIC_*-prefixed vars to
# the app, and inlines them at build time, so ONLY put client-safe values here.
# NEVER add backend secrets (DATABASE_URL, AWS_*, SENDGRID_*, SECRET_KEY,
# PAYSTACK_SECRET_KEY) — those live only in backend/server/.env.

# Django REST API base URL.
# Production (what the web apps use):
#   https://24-telemed-admin.thebooleantech.com.ng
# Local backend: use your machine's LAN IP (a device/emulator can't reach
# "localhost"), e.g. http://192.168.1.20:8000, and run the backend with
#   python manage.py runserver 0.0.0.0:8000
EXPO_PUBLIC_API_BASE_URL=https://24-telemed-admin.thebooleantech.com.ng

# WebSocket URL for live call signalling. The Channels consumer is mounted at
# /video_call/ (backend server/asgi.py), so include that path.
EXPO_PUBLIC_WEBSOCKET_BASE=wss://24-telemed-admin.thebooleantech.com.ng/video_call/

# Origin sent on the call WebSocket (must be in the backend's ALLOWED_ORIGINS).
# Defaults to the API base. For the local Docker backend, use http://localhost.
# EXPO_PUBLIC_WS_ORIGIN=http://localhost

# videosdk.live static client token used to join video calls.
EXPO_PUBLIC_VIDEO_SDK_TOKEN=

# Paystack PUBLIC key (pk_live_... / pk_test_...) for in-app wallet funding.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Deployed web apps — the in-call screen loads their /meeting/:id page in a
# WebView, reusing the existing web video stack.
EXPO_PUBLIC_PERSONNEL_WEB_URL=https://personnel-connect.24telemed.org
EXPO_PUBLIC_DOCTOR_WEB_URL=https://doctor-connect.24telemed.org

# Support contact shown on login / help screens.
EXPO_PUBLIC_ADMIN_CONTACT_EMAIL=info@24telemed.org
EXPO_PUBLIC_ADMIN_CONTACT_PHONE=+2348130790883
